#!/usr/bin/env python3
import subprocess
import sys
import pathlib
import readline

# --- Configurazioni ---
DOCKER_CONTAINER = "ollama"
MODEL = "deepseek-r1:1.5b"
HISTORY_FILE = pathlib.Path.home() / ".sk_ai_history"
HISTORY_FILE.touch(exist_ok=True)
BASE_PROMPT = "Write only a command, no description, no external text, only the translation of the question into one or a sequence of shell commands: "

# --- Readline per cronologia e freccette ---
readline.read_history_file(str(HISTORY_FILE))
readline.set_history_length(1000)

def save_history():
    readline.write_history_file(str(HISTORY_FILE))

def ask(prompt_text):
    try:
        return input(prompt_text).strip()
    except (KeyboardInterrupt, EOFError):
        print("\n[!] Uscita.")
        save_history()
        sys.exit(0)

def send_to_ollama(prompt):
    """Invia il prompt a Ollama via Docker e ritorna la risposta"""
    try:
        result = subprocess.run(
            ["docker", "exec", "-i", DOCKER_CONTAINER, "ollama", "run", MODEL],
            input=prompt + "\n",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30
        )
        if result.returncode == 0:
            return result.stdout.strip()
        else:
            return f"[Errore Ollama: {result.stderr.strip()}]"
    except Exception as e:
        return f"[Errore: {e}]"

def execute_command(command):
    try:
        subprocess.run(command, shell=True)
    except Exception as e:
        print(f"[Errore esecuzione comando: {e}]")

def main():
    print("\033[1;34mBenvenuto in Sk_ai Terminal (Ctrl+D per uscire)\033[0m\n")
    while True:
        user_input = ask("\033[1;34m┌──(Sk_ai ㉿terminal)-\033[0m\033[1;36m[Inserisci la tua richiesta]\033[0m\n\033[1;34m└─$\033[0m ")
        if not user_input:
            print("\033[1;31m[!] Nessun input fornito.\033[0m")
            continue

        # Salva cronologia
        readline.add_history(user_input)
        save_history()

        # Comandi di uscita
        if user_input.lower() in ["exit", "quit"]:
            print("\033[1;31m[*] Uscita.\033[0m")
            save_history()
            break

        # Controlla se è un comando shell valido
        from shutil import which
        command_base = user_input.split()[0]
        if which(command_base):
            execute_command(user_input)
            continue

        # Invio all'AI
        full_prompt = f"{BASE_PROMPT} {user_input}"
        ai_command = send_to_ollama(full_prompt)
        print(f"\n\033[1;36m[+] Comando suggerito:\033[0m {ai_command}")

        # Conferma prima di eseguire
        while True:
            scelta = ask("\033[1;33m┌──(Sk_ai ㉿skai)-[Eseguire il comando? y/n/s (spiega)]:\033[0m\n\033[1;33m└─>\033[0m ").lower()
            if scelta in ["y", ""]:
                print(f"\033[1;32m[+] Eseguendo: {ai_command}\033[0m")
                execute_command(ai_command)
                readline.add_history(ai_command)
                save_history()
                break
            elif scelta == "n":
                print("\033[1;31m[-] Comando annullato.\033[0m")
                break
            elif scelta == "s":
                spiegazione_prompt = f"Spiega dettagliatamente cosa fa il seguente comando shell: {ai_command}"
                spiegazione = send_to_ollama(spiegazione_prompt)
                print(f"\033[1;35m[Spiegazione]:\033[0m {spiegazione}")
            else:
                print("\033[1;35m[!] Scelta non valida. Riprova.\033[0m")

        print()

if __name__ == "__main__":
    main()
