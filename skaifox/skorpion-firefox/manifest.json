{
  "manifest_version": 2,
  "name": "SkAi",
  "version": "1.0.0",
  "description": "AI browser agent powered by Qwen3 via Ollama — parte di SkAi",
  "author": "SkAi",

  "icons": {
    "16":  "icons/skorpion-16.png",
    "32":  "icons/skorpion-32.png",
    "48":  "icons/skorpion-48.png",
    "96":  "icons/skorpion-96.png",
    "128": "icons/skorpion-128.png"
  },

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation",
    "history",
    "bookmarks",
    "notifications",
    "<all_urls>",
    "http://localhost:11434/*"
  ],

  "background": {
    "scripts": [
      "src/shared/constants.js",
      "src/shared/ollama.js",
      "src/background/background.js"
    ]
  },

  "sidebar_action": {
    "default_panel": "src/sidebar/sidebar.html",
    "default_title": "SkAi",
    "default_icon": {
      "16":  "icons/skorpion-16.png",
      "32":  "icons/skorpion-32.png",
      "48":  "icons/skorpion-48.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": ["src/sidebar/*", "icons/*"]
}
